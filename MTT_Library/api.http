@baseUrl = http://127.0.0.1:8001
@username = alice
@password = password123
@token = paste-login-token-here
@refreshToken = paste-refresh-token-here
@bookId = paste-book-id-here

### 1. API home
GET {{baseUrl}}/

### 2. Register user
POST {{baseUrl}}/register/
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### 3. Login and get JWT
# Copy token from the response and replace @token above.
POST {{baseUrl}}/login/
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

### 4. Refresh token (old refresh token is revoked)
POST {{baseUrl}}/refresh/
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### 5. Refresh token replay must fail with 401
POST {{baseUrl}}/refresh/
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### 6. Logout and revoke access + refresh tokens
POST {{baseUrl}}/logout/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### 7. Revoked access token must fail with 401
GET {{baseUrl}}/books/
Authorization: Bearer {{token}}

### 8. Invalid login must return 401
POST {{baseUrl}}/login/
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "wrong-password"
}

### 9. List books - public
GET {{baseUrl}}/books/

### 10. Create book without JWT must return 401
POST {{baseUrl}}/books/create/
Content-Type: application/json

{
  "title": "Unauthorized Book",
  "authors": ["Author"],
  "publisher": "Publisher"
}

### 11. Create book - JWT required
POST {{baseUrl}}/books/create/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Clean Code",
  "authors": ["Robert C. Martin"],
  "publisher": "Prentice Hall",
  "description": "A practical guide to writing readable code."
}

### 12. Get book by id - public
GET {{baseUrl}}/books/{{bookId}}/

### 13. Update owned book - JWT required
PUT {{baseUrl}}/books/{{bookId}}/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Clean Architecture",
  "authors": ["Robert C. Martin"],
  "publisher": "Pearson",
  "description": "Updated book description."
}

### 14. Delete owned book - JWT required
DELETE {{baseUrl}}/books/{{bookId}}/
Authorization: Bearer {{token}}

### 15. List users - admin JWT required
GET {{baseUrl}}/admin/users/
Authorization: Bearer {{token}}

### 16. Create user - admin JWT required
POST {{baseUrl}}/admin/users/create/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "bob",
  "password": "password123",
  "role": "user"
}

### 17. Update user - admin JWT required
PUT {{baseUrl}}/admin/users/bob/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "admin"
}

### 18. Delete user - admin JWT required
DELETE {{baseUrl}}/admin/users/bob/
Authorization: Bearer {{token}}

### 19. Non-admin user must get 403 on admin API
# Login as alice first and replace @token with alice access_token.
GET {{baseUrl}}/admin/users/
Authorization: Bearer {{token}}

### 20. Invalid book payload must return 400
POST {{baseUrl}}/books/create/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "",
  "authors": [],
  "publisher": ""
}
