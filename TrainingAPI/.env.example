# Example environment variables for TrainingAPI
# Copy this file to `.env` and adjust values as needed for your environment.

# Server / app settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_NAME=http://0.0.0.0:8080
SECRET_KEY=dev-secret
EXPIRATION_JWT=3600
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

API_HOST=0.0.0.0:8080
API_VERSION=3.1.0

# Existing Mongo connection values used by the app when running outside docker or if app reads these keys.
# Keep these for compatibility; however the docker-compose uses MONGO_INITDB_* for initializing the container.
MONGO_CONNECTION_URL=mongodb://localhost:27017/
MONGO_DATABASE=example_db

# Recommended variables for the bundled Mongo container (used by docker-compose to initialize DB):
MONGO_INITDB_ROOT_USERNAME=mongo_root
MONGO_INITDB_ROOT_PASSWORD=mongo_pass
MONGO_INITDB_DATABASE=training_db

#Redis connection values used by the app when running outside docker or if app reads these keys.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional override: if you already run Mongo locally and want the containerized app to use it,
# set MONGO_URI to point to the host Mongo instance. Example (macOS/Windows Docker):
# MONGO_URI=mongodb://host.docker.internal:27017/training_db
# On Linux you may need to use the host IP (for example 172.17.0.1) or leave blank and run the app outside Docker.
# If MONGO_URI is set, the app should prefer it over the internal container's connection string.
# MONGO_URI=

# Optional: expose the Mongo container's 27017 on the host (useful for direct DB access from host).
# Format: hostPort:containerPort
# WARNING: enable this only if you understand it may conflict with a local MongoDB instance.
# MONGO_PORT_MAPPING=27017:27017
